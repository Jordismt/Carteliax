# Frontend only: no service role, Stripe secret or Groq key here.
# Vercel Production: both API URLs = https://carteliax-api.vercel.app (no /api suffix).
NUXT_API_BASE_URL=http://localhost:5000
NUXT_PUBLIC_API_URL=http://localhost:5000
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Canonical public origin; never use a Preview URL for Production.
NUXT_PUBLIC_SITE_URL=https://www.carteliax.com
