{
  "type": "LOCAL_VERCEL_OUTPUT_INSPECTION",
  "runtime": "nodejs22.x",
  "handler": "index.mjs",
  "preset": "vercel",
  "framework": {
    "name": "nuxt",
    "version": "4.6.0"
  },
  "routes": [
    {
      "src": "/api/public/sites/(?<slug>[^/]+)",
      "dest": "/api/public/sites/[slug]"
    },
    {
      "src": "/api/public/menus/(?<businessId>[^/]+)/(?<slug>[^/]+)",
      "dest": "/api/public/menus/[businessId]/[slug]"
    },
    {
      "src": "/(?<publicSlug>[^/]+)",
      "dest": "/[publicSlug]"
    }
  ],
  "functionAliasesExist": true
}
