PORT=5000
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
STRIPE_MODE=test
# Standard (sk_) or restricted (rk_) key; permissions must cover backend API calls.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME
# Monthly 1749 EUR inclusive Price + active ES VAT 21% inclusive Tax Rate, same mode.
STRIPE_VAT_TAX_RATE_ID=txr_REPLACE_ME

# Apply supabase/migrations/202610070001_business_microsites.sql before enabling.
MICROSITES_ENABLED=false
# Apply supabase/migrations/202610060001_menu_translations.sql before enabling.
TRANSLATIONS_ENABLED=false
# Backend only. Never prefix with NUXT_PUBLIC or commit real keys.
GROQ_API_KEY=
GROQ_TRANSLATION_MODEL=openai/gpt-oss-120b
